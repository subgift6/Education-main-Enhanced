# Required for a predictable admin login. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Required for stable session/password hashing across restarts. Generate once and keep it stable.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional: only set this if you intentionally need the forward-proxy endpoint.
# Use a long random token and send it as X-Proxy-Token. Without it, /proxy is disabled.
PROXY_TOKEN=

# For persistent state, mount a Railway Volume at /data.
DATA_DIR=/data
